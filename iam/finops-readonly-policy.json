{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InventoryRead",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "elasticloadbalancing:Describe*",
        "rds:Describe*",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads",
        "s3:GetLifecycleConfiguration",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "tag:GetResources",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CostAndOptimizationRead",
      "Effect": "Allow",
      "Action": [
        "ce:Get*",
        "ce:Describe*",
        "ce:List*",
        "compute-optimizer:Get*",
        "compute-optimizer:Describe*",
        "savingsplans:Describe*",
        "savingsplans:List*",
        "pricing:GetProducts",
        "pricing:DescribeServices",
        "pricing:GetAttributeValues"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyAllMutationHardGuarantee",
      "Effect": "Deny",
      "NotAction": [
        "ec2:Describe*",
        "elasticloadbalancing:Describe*",
        "rds:Describe*",
        "s3:ListAllMyBuckets",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads",
        "s3:GetLifecycleConfiguration",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "tag:GetResources",
        "sts:GetCallerIdentity",
        "ce:Get*",
        "ce:Describe*",
        "ce:List*",
        "compute-optimizer:Get*",
        "compute-optimizer:Describe*",
        "savingsplans:Describe*",
        "savingsplans:List*",
        "pricing:GetProducts",
        "pricing:DescribeServices",
        "pricing:GetAttributeValues"
      ],
      "Resource": "*"
    }
  ]
}
